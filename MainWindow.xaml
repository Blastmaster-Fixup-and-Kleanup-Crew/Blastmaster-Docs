<Window
    x:Class="WinUI3TextEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Menu Bar -->
        <MenuBar Grid.Row="0">
            <!-- FILE MENU -->
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New" Click="OnFileItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open..." Click="OnFileItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save" Click="OnFileItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Save As..." Click="OnFileItemClick"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="OnFileItemClick"/>
            </MenuBarItem>

            <!-- EDIT MENU -->
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem Text="Undo" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Redo" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Cut" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="X" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Copy" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Paste" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Select All" Click="OnEditItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="A" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <!-- VIEW MENU -->
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Normal" Click="OnViewModeClick"/>
                <MenuFlyoutItem Text="Page Layout" Click="OnViewModeClick"/>
                <MenuFlyoutItem Text="Outline" Click="OnViewModeClick"/>
                <MenuFlyoutItem Text="Master Document" Click="OnViewModeClick"/>
                <ToggleMenuFlyoutItem x:Name="FullScreenToggle" Text="Full Screen" Click="OnFullScreenToggle"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutSubItem Text="Toolbars">
                    <ToggleMenuFlyoutItem x:Name="StandardToolbarToggle" Text="Standard" IsChecked="True" Click="OnToggleToolbarClick"/>
                    <ToggleMenuFlyoutItem x:Name="FormattingToolbarToggle" Text="Formatting" IsChecked="True" Click="OnToggleToolbarClick"/>
                    <ToggleMenuFlyoutItem x:Name="DrawingToolbarToggle" Text="Drawing" IsChecked="True" Click="OnToggleToolbarClick"/>
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="RulerToggle" Text="Ruler" IsChecked="True" Click="OnToggleRulerClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Header and Footer" Click="OnOpenPaneClick"/>
                <MenuFlyoutItem Text="Footnotes" Click="OnOpenPaneClick"/>
                <MenuFlyoutItem Text="Annotations" Click="OnOpenPaneClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Zoom..." Click="OnZoomClick"/>
            </MenuBarItem>

            <!-- INSERT MENU -->
            <MenuBarItem Title="Insert">
                <MenuFlyoutSubItem Text="Break">
                    <MenuFlyoutItem Text="Page Break" Click="OnInsertItemClick"/>
                    <MenuFlyoutItem Text="Column Break" Click="OnInsertItemClick"/>
                    <MenuFlyoutItem Text="Section Break" Click="OnInsertItemClick"/>
                </MenuFlyoutSubItem>

                <MenuFlyoutItem Text="Page Numbers..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Date and Time..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="AutoText..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Field..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Symbol..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Form Field..." Click="OnInsertItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutSubItem Text="Reference">
                    <MenuFlyoutItem Text="Footnote..." Click="OnInsertItemClick"/>
                    <MenuFlyoutItem Text="Caption..." Click="OnInsertItemClick"/>
                    <MenuFlyoutItem Text="Cross-reference..." Click="OnInsertItemClick"/>
                    <MenuFlyoutItem Text="Index and Tables..." Click="OnInsertItemClick"/>
                </MenuFlyoutSubItem>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="File..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Frame" Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Picture..." Click="OnInsertItemClick"/>
                <MenuFlyoutItem Text="Object..." Click="OnInsertItemClick"/>
            </MenuBarItem>

            <!-- FORMAT MENU -->
            <MenuBarItem Title="Format">
                <MenuFlyoutItem Text="Font..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Paragraph..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Tabs..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Borders and Shading..." Click="OnFormatItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Columns..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Change Case..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Drop Cap..." Click="OnFormatItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Bullets and Numbering..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Heading Numbering..." Click="OnFormatItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="AutoFormat..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Style Gallery..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Style..." Click="OnFormatItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Frame..." Click="OnFormatItemClick"/>
                <MenuFlyoutItem Text="Drawing Object..." Click="OnFormatItemClick"/>
            </MenuBarItem>

            <!-- TOOLS MENU -->
            <MenuBarItem Title="Tools">
                <MenuFlyoutSubItem Text="Language">
                    <MenuFlyoutItem Text="Spelling..." Click="OnToolsItemClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F7"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Grammar..." Click="OnToolsItemClick"/>
                    <MenuFlyoutItem Text="Thesaurus..." Click="OnToolsItemClick"/>
                    <MenuFlyoutItem Text="Hyphenation..." Click="OnToolsItemClick"/>
                    <MenuFlyoutItem Text="Set Language..." Click="OnToolsItemClick"/>
                </MenuFlyoutSubItem>

                <MenuFlyoutItem Text="Word Count..." Click="OnToolsItemClick"/>
                <MenuFlyoutItem Text="AutoCorrect..." Click="OnToolsItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Mail Merge..." Click="OnToolsItemClick"/>
                <MenuFlyoutItem Text="Envelopes and Labels..." Click="OnToolsItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Protect Document..." Click="OnToolsItemClick"/>
                <MenuFlyoutItem Text="Revision Marks..." Click="OnToolsItemClick"/>

                <MenuFlyoutSubItem Text="Macro">
                    <MenuFlyoutItem Text="Macros..." Click="OnToolsItemClick"/>
                    <MenuFlyoutItem Text="Record New Macro..." Click="OnToolsItemClick"/>
                </MenuFlyoutSubItem>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Customize..." Click="OnToolsItemClick"/>
                <MenuFlyoutItem Text="Options..." Click="OnToolsItemClick"/>
            </MenuBarItem>

            <!-- TABLE MENU -->
            <MenuBarItem Title="Table">
                <MenuFlyoutItem Text="Insert Rows" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Insert Columns" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Delete Rows" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Delete Columns" Click="OnTableItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Merge Cells" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Split Cells..." Click="OnTableItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Select Row" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Select Column" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Select Table" Click="OnTableItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Table AutoFormat..." Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Cell Height and Width..." Click="OnTableItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="Headings" Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Convert Text to Table..." Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Sort..." Click="OnTableItemClick"/>
                <MenuFlyoutItem Text="Formula..." Click="OnTableItemClick"/>

                <MenuFlyoutSeparator/>

                <ToggleMenuFlyoutItem x:Name="GridlinesToggle" Text="Gridlines" IsChecked="True" Click="OnToggleGridlinesClick"/>
            </MenuBarItem>

            <!-- WINDOW MENU -->
            <MenuBarItem Title="Window">
                <MenuFlyoutItem Text="New Window" Click="OnWindowItemClick"/>
                <MenuFlyoutItem Text="Arrange All" Click="OnWindowItemClick"/>
                <MenuFlyoutItem Text="Split" Click="OnWindowItemClick"/>

                <MenuFlyoutSeparator/>

                <RadioMenuFlyoutItem Text="1 Document1" GroupName="OpenDocuments" IsChecked="True" Click="OnSwitchDocumentClick"/>
                <RadioMenuFlyoutItem Text="2 Document2" GroupName="OpenDocuments" Click="OnSwitchDocumentClick"/>
            </MenuBarItem>

            <!-- HELP MENU -->
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Blastmaster Docs Help Topics" Click="OnHelpItemClick">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Answer Wizard..." Click="OnHelpItemClick"/>
                <MenuFlyoutItem Text="Microsoft Word Help..." Click="OnHelpItemClick"/>

                <MenuFlyoutSeparator/>

                <MenuFlyoutItem Text="About Blastmaster Docs" Click="OnHelpItemClick"/>
            </MenuBarItem>
        </MenuBar>

        <!-- Top Toolbars Area -->
        <StackPanel Grid.Row="1" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <!-- STANDARD TOOLBAR -->
            <ScrollViewer x:Name="StandardToolbar" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Padding="4,2" Spacing="2">
                    <Button ToolTipService.ToolTip="New Document" Click="OnStandardToolbarButtonClick" Tag="New">
                        <SymbolIcon Symbol="Document"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Open File" Click="OnStandardToolbarButtonClick" Tag="Open">
                        <SymbolIcon Symbol="Folder"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Save" Click="OnStandardToolbarButtonClick" Tag="Save">
                        <SymbolIcon Symbol="Save"/>
                    </Button>
                    
                    <AppBarSeparator/>

                    <Button ToolTipService.ToolTip="Print" Click="OnStandardToolbarButtonClick" Tag="Print">
                        <SymbolIcon Symbol="Print"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Print Preview" Click="OnStandardToolbarButtonClick" Tag="Print Preview">
                        <FontIcon Glyph="&#xE8A1;"/>
                    </Button>

                    <AppBarSeparator/>

                    <Button ToolTipService.ToolTip="Spelling" Click="OnStandardToolbarButtonClick" Tag="Spelling">
                        <FontIcon Glyph="&#xF1D3;"/>
                    </Button>

                    <AppBarSeparator/>

                    <Button ToolTipService.ToolTip="Cut" Click="OnStandardToolbarButtonClick" Tag="Cut">
                        <SymbolIcon Symbol="Cut"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Copy" Click="OnStandardToolbarButtonClick" Tag="Copy">
                        <SymbolIcon Symbol="Copy"/>
                    </Button>

                    <Button ToolTipService.ToolTip="Paste" Click="OnStandardToolbarButtonClick" Tag="Paste">
                        <SymbolIcon Symbol="Paste"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Format Painter" Click="OnStandardToolbarButtonClick" Tag="Format Painter">
                        <FontIcon Glyph="&#xE72B;"/>
                    </Button>

                    <AppBarSeparator/>

                    <Button ToolTipService.ToolTip="Undo" Click="OnStandardToolbarButtonClick" Tag="Undo">
                        <SymbolIcon Symbol="Undo"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Redo / Repeat" Click="OnStandardToolbarButtonClick" Tag="Redo">
                        <SymbolIcon Symbol="Redo"/>
                    </Button>

                    <AppBarSeparator/>

                    <Button ToolTipService.ToolTip="AutoFormat" Click="OnStandardToolbarButtonClick" Tag="AutoFormat">
                        <FontIcon Glyph="&#xE8B8;"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Insert Table" Click="OnStandardToolbarButtonClick" Tag="Insert Table">
                        <FontIcon Glyph="&#xE7B8;"/>
                    </Button>
                    <Button ToolTipService.ToolTip="Columns" Click="OnStandardToolbarButtonClick" Tag="Columns">
                        <FontIcon Glyph="&#xE82D;"/>
                    </Button>

                    <AppBarSeparator/>

                    <ToggleButton x:Name="DrawingToolbarButton" ToolTipService.ToolTip="Drawing" IsChecked="True" Click="OnStandardToolbarButtonClick" Tag="Drawing">
                        <FontIcon Glyph="&#xE76D;"/>
                    </ToggleButton>
                    <ToggleButton ToolTipService.ToolTip="Show/Hide Non-Printing Characters (¶)" Click="OnStandardToolbarButtonClick" Tag="ShowHideCharacters">
                        <TextBlock Text="¶" FontWeight="Bold"/>
                    </ToggleButton>

                    <AppBarSeparator/>

                    <ComboBox Width="110" SelectedIndex="2" SelectionChanged="OnZoomComboBoxChanged" ToolTipService.ToolTip="Zoom Control" VerticalAlignment="Center">
                        <ComboBoxItem Content="200%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="Page Width"/>
                    </ComboBox>

                    <Button ToolTipService.ToolTip="Help" Click="OnStandardToolbarButtonClick" Tag="Help">
                        <SymbolIcon Symbol="Help"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- FORMATTING TOOLBAR (Placeholder) -->
            <StackPanel x:Name="FormattingToolbar" Orientation="Horizontal" Padding="4,2" Spacing="2">
                <Button Content="Bold" Margin="0,0,4,0"/>
                <Button Content="Italic" Margin="0,0,4,0"/>
                <Button Content="Underline" Margin="0,0,4,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ruler Component -->
            <Border x:Name="RulerBar" Grid.Row="0" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Height="20" Padding="10,0">
                <TextBlock Text="[--- Ruler ---]" VerticalAlignment="Center" FontSize="10" Foreground="Gray"/>
            </Border>

            <!-- Document Text Canvas -->
            <TextBox x:Name="EditorBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10" PlaceholderText="Type your document here..."/>
        </Grid>

        <!-- DRAWING TOOLBAR (Bottom Workspace Dock) -->
        <ScrollViewer x:Name="DrawingToolbar" Grid.Row="3" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" Padding="4,2" Spacing="2">
                <ToggleButton ToolTipService.ToolTip="Select Object" Click="OnDrawingToolbarButtonClick" Tag="Select Object">
                    <FontIcon Glyph="&#xEF20;"/>
                </ToggleButton>

                <AppBarSeparator/>

                <Button ToolTipService.ToolTip="Line" Click="OnDrawingToolbarButtonClick" Tag="Line">
                    <FontIcon Glyph="&#xE960;"/>
                </Button>
                <Button ToolTipService.ToolTip="Rectangle" Click="OnDrawingToolbarButtonClick" Tag="Rectangle">
                    <FontIcon Glyph="&#xE751;"/>
                </Button>
                <Button ToolTipService.ToolTip="Ellipse" Click="OnDrawingToolbarButtonClick" Tag="Ellipse">
                    <FontIcon Glyph="&#xEA3A;"/>
                </Button>
                <Button ToolTipService.ToolTip="Arc" Click="OnDrawingToolbarButtonClick" Tag="Arc">
                    <FontIcon Glyph="&#xF57B;"/>
                </Button>
                <Button ToolTipService.ToolTip="Freeform" Click="OnDrawingToolbarButtonClick" Tag="Freeform">
                    <FontIcon Glyph="&#xEDC6;"/>
                </Button>

                <AppBarSeparator/>

                <Button ToolTipService.ToolTip="Text Box" Click="OnDrawingToolbarButtonClick" Tag="Text Box">
                    <FontIcon Glyph="&#xE8C7;"/>
                </Button>
                <Button ToolTipService.ToolTip="Callout" Click="OnDrawingToolbarButtonClick" Tag="Callout">
                    <FontIcon Glyph="&#xE25C;"/>
                </Button>
                <Button ToolTipService.ToolTip="Format Callout" Click="OnDrawingToolbarButtonClick" Tag="Format Callout">
                    <FontIcon Glyph="&#xE713;"/>
                </Button>

                <AppBarSeparator/>

                <Button ToolTipService.ToolTip="Fill Color" Click="OnDrawingToolbarButtonClick" Tag="Fill Color">
                    <FontIcon Glyph="&#xE771;"/>
                </Button>
                <Button ToolTipService.ToolTip="Line Color" Click="OnDrawingToolbarButtonClick" Tag="Line Color">
                    <FontIcon Glyph="&#xE76D;"/>
                </Button>

                <DropDownButton ToolTipService.ToolTip="Line Style">
                    <FontIcon Glyph="&#xE7C8;"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="1 pt Thin" Click="OnDrawingToolbarButtonClick" Tag="Line Style: Solid Thin"/>
                            <MenuFlyoutItem Text="3 pt Thick" Click="OnDrawingToolbarButtonClick" Tag="Line Style: Solid Thick"/>
                            <MenuFlyoutItem Text="Dashed" Click="OnDrawingToolbarButtonClick" Tag="Line Style: Dashed"/>
                            <MenuFlyoutItem Text="Dotted" Click="OnDrawingToolbarButtonClick" Tag="Line Style: Dotted"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <AppBarSeparator/>

                <Button ToolTipService.ToolTip="Bring to Front" Click="OnDrawingToolbarButtonClick" Tag="Bring to Front">
                    <FontIcon Glyph="&#xE898;"/>
                </Button>
                <Button ToolTipService.ToolTip="Send to Back" Click="OnDrawingToolbarButtonClick" Tag="Send to Back">
                    <FontIcon Glyph="&#xE899;"/>
                </Button>

                <AppBarSeparator/>

                <Button ToolTipService.ToolTip="Group" Click="OnDrawingToolbarButtonClick" Tag="Group">
                    <FontIcon Glyph="&#xE71D;"/>
                </Button>

                <Button ToolTipService.ToolTip="Ungroup" Click="OnDrawingToolbarButtonClick" Tag="Ungroup">
                    <FontIcon Glyph="&#xE71E;"/>
                </Button>

                <AppBarSeparator/>

                <DropDownButton ToolTipService.ToolTip="Rotate / Flip">
                    <FontIcon Glyph="&#xE7AD;"/>
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Flip Horizontal" Click="OnDrawingToolbarButtonClick" Tag="Flip Horizontal"/>
                            <MenuFlyoutItem Text="Flip Vertical" Click="OnDrawingToolbarButtonClick" Tag="Flip Vertical"/>
                            <MenuFlyoutItem Text="Rotate Right 90°" Click="OnDrawingToolbarButtonClick" Tag="Rotate Right"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button ToolTipService.ToolTip="Reshape" Click="OnDrawingToolbarButtonClick" Tag="Reshape">
                    <FontIcon Glyph="&#xE77B;"/>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="{ThemeResource SystemControlBackgroundChromeLowBrush}" Padding="10,4">
            <TextBlock x:Name="StatusText" Text="Mode: Normal | Zoom: 100%" FontSize="12"/>
        </Border>
    </Grid>
</Window>
